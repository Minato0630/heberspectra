{
  "version": 2,
  "rewrites": [
    { "source": "/api/database", "destination": "/api/database.js" },
    { "source": "/api/send-email", "destination": "/api/send-email.js" },
    { "source": "/api", "destination": "/api/index.js" },
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
